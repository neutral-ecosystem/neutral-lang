{
  "format": "neutral-vocabulary-bundle",
  "encoding_version": "1.0",
  "schema_version": "2.0",
  "identity": "BenchDomain",
  "version": "1.0.0",
  "required_features": ["vocabulary-composition-v2"],
  "dependencies": [],
  "types": [
    {
      "kind": "record",
      "name": "Config",
      "public": true,
      "fields": [
        {
          "name": "attempts",
          "type": {"kind": "num"},
          "presence": "defaulted",
          "restrictions": {"minimum": "1", "maximum": "3"},
          "default": {"kind": "num", "value": "3"}
        },
        {
          "name": "labels",
          "type": {"kind": "list", "element": {"kind": "string"}},
          "presence": "defaulted",
          "restrictions": {"max_length": "8"},
          "default": {"kind": "list", "items": [{"kind": "string", "value": "benchmark"}]}
        }
      ]
    }
  ]
}
