{
  "format": "neutral-vocabulary-bundle",
  "encoding_version": "1.0",
  "schema_version": "2.0",
  "identity": "PipelineDomain",
  "version": "1.0.0",
  "required_features": ["vocabulary-composition-v2"],
  "dependencies": [],
  "types": [
    {
      "kind": "record",
      "name": "Operation",
      "public": true,
      "fields": []
    },
    {
      "kind": "record",
      "name": "Plan",
      "public": true,
      "fields": [
        {
          "name": "value",
          "type": {"kind": "num"},
          "presence": "required",
          "restrictions": {"minimum": "0", "maximum": "3"}
        }
      ]
    },
    {
      "kind": "record",
      "name": "Result",
      "public": true,
      "fields": [
        {
          "name": "values",
          "type": {
            "kind": "list",
            "element": {"kind": "nominal", "name": "State"}
          },
          "presence": "optional",
          "restrictions": {}
        }
      ]
    },
    {
      "kind": "variant",
      "name": "State",
      "public": true,
      "alternatives": [
        {"tag": "failed", "type": {"kind": "string"}},
        {"tag": "ready", "type": {"kind": "num"}}
      ]
    }
  ]
}
