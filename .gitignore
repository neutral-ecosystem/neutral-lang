# SPDX-License-Identifier: Apache-2.0

# Cargo build output (including the isolated fuzz workspace)
debug
target
test-results/
# Raw release measurements can contain host paths and must never enter Git.
/quality/evidence/*/gates/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Generated coverage-guided fuzz state
fuzz/artifacts/
fuzz/corpus/*
!fuzz/corpus/README.md
fuzz/coverage/
# Direct libFuzzer runs can leave findings beside the harness or at the root.
/crash-*
/timeout-*
/oom-*
/leak-*
/slow-unit-*
/fuzz/crash-*
/fuzz/timeout-*
/fuzz/oom-*
/fuzz/leak-*
/fuzz/slow-unit-*

# Generated profiler and raw coverage data
massif.out.*
callgrind.out.*
perf.data*
*.profraw
*.profdata
/massif.out
/callgrind.out

# Local distribution staging outside the owned result root
/dist/
/release/

# Editor and desktop state
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Local environment overrides; the documented template remains tracked.
.env
.env.*
!.env.example
