{
  "format": "neutral-vocabulary-bundle",
  "encoding_version": "1.0",
  "schema_version": "2.0",
  "identity": "ExpressionDomain",
  "version": "1.0.0",
  "required_features": [
    "vocabulary-composition-v2"
  ],
  "dependencies": [],
  "types": [
    {
      "kind": "record",
      "name": "Bounded",
      "public": true,
      "fields": [
        {
          "name": "count",
          "type": {
            "kind": "num"
          },
          "presence": "required",
          "restrictions": {
            "minimum": "0",
            "maximum": "3"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          },
          "presence": "required",
          "restrictions": {
            "min_length": "1",
            "max_length": "2"
          }
        },
        {
          "name": "items",
          "type": {
            "kind": "list",
            "element": {
              "kind": "num"
            }
          },
          "presence": "defaulted",
          "restrictions": {
            "max_length": "2"
          },
          "default": {
            "kind": "list",
            "items": []
          }
        },
        {
          "name": "mode",
          "type": {
            "kind": "string"
          },
          "presence": "defaulted",
          "restrictions": {
            "choices": [
              {
                "kind": "string",
                "value": "safe"
              },
              {
                "kind": "string",
                "value": "fast"
              }
            ]
          },
          "default": {
            "kind": "string",
            "value": "safe"
          }
        }
      ]
    }
  ]
}
